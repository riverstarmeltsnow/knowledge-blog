<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cuit.mygit.mapper.CommentMapper">

    <select id="selectById" resultType="Comment">
        SELECT comment_id,
               content,
               user_id,
               article_id,
               parent_id,
               reply_to_user_id,
               create_time
        FROM comment
        WHERE comment_id = #{commentId}
    </select>

    <select id="selectByArticleId" resultType="Comment">
        SELECT comment_id,
               content,
               user_id,
               article_id,
               parent_id,
               reply_to_user_id,
               create_time
        FROM comment
        WHERE article_id = #{articleId}
        ORDER BY create_time DESC
    </select>

    <select id="selectByUserId" resultType="Comment">
        SELECT comment_id,
               content,
               user_id,
               article_id,
               parent_id,
               reply_to_user_id,
               create_time
        FROM comment
        WHERE user_id = #{userId}
        ORDER BY create_time DESC
    </select>

    <!-- 新增后把自增主键回填到 commentId 上；评论时间交给数据库默认值。
         parent_id 和 reply_to_user_id 为空就是顶层评论（直接评论文章），
         MyBatis 会把 Java 的 null 写成数据库的 NULL，正合要求。 -->
    <insert id="insert" parameterType="Comment" useGeneratedKeys="true" keyProperty="commentId">
        INSERT INTO comment (content, user_id, article_id, parent_id, reply_to_user_id)
        VALUES (#{content}, #{userId}, #{articleId}, #{parentId}, #{replyToUserId})
    </insert>

    <delete id="deleteById">
        DELETE FROM comment
        WHERE comment_id = #{commentId}
    </delete>

    <delete id="deleteByArticleId">
        DELETE FROM comment
        WHERE article_id = #{articleId}
    </delete>

    <!-- 删某条顶层评论下面的所有回复。必须在删顶层评论之前调用，
         否则 reply 的 parent_id 外键会拦住删除 -->
    <delete id="deleteByParentId">
        DELETE FROM comment
        WHERE parent_id = #{parentId}
    </delete>

    <delete id="deleteByUserId">
        DELETE FROM comment
        WHERE user_id = #{userId}
    </delete>

    <!-- 统计条数返回的是数字，所以 resultType 写 int（不是实体类） -->
    <select id="countByArticleId" resultType="int">
        SELECT COUNT(*)
        FROM comment
        WHERE article_id = #{articleId}
    </select>

</mapper>
