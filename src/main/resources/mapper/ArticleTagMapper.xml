<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cuit.mygit.mapper.ArticleTagMapper">

    <!--
        查"某篇文章贴了哪些标签"。
        中间表里只有两个ID，光靠它显示不出标签名，所以要 JOIN 到 tag 表取名字。

        这里给两张表起了短别名 atg / t，后面用别名.字段名区分是哪个表的字段，
        不这么做的话，两张表都有 tag_id，MySQL 会报"字段名不明确"。

        返回类型是 Tag 不是 ArticleTag —— 因为查出来的就是标签本身。
    -->
    <select id="selectTagsByArticleId" resultType="Tag">
        SELECT t.tag_id,
               t.name
        FROM tag t
                 INNER JOIN article_tag atg ON t.tag_id = atg.tag_id
        WHERE atg.article_id = #{articleId}
        ORDER BY t.tag_id ASC
    </select>

    <select id="selectOne" resultType="ArticleTag">
        SELECT article_id,
               tag_id
        FROM article_tag
        WHERE article_id = #{articleId}
          AND tag_id = #{tagId}
    </select>

    <insert id="insert" parameterType="ArticleTag">
        INSERT INTO article_tag (article_id, tag_id)
        VALUES (#{articleId}, #{tagId})
    </insert>

    <!--
        删除指定的那一条关联。
        这里两个条件都要写：只写 article_id 会把整篇文章的标签全删了。
    -->
    <delete id="delete">
        DELETE FROM article_tag
        WHERE article_id = #{articleId}
          AND tag_id = #{tagId}
    </delete>

    <delete id="deleteByArticleId">
        DELETE FROM article_tag
        WHERE article_id = #{articleId}
    </delete>

    <delete id="deleteByTagId">
        DELETE FROM article_tag
        WHERE tag_id = #{tagId}
    </delete>

    <select id="countByTagId" resultType="int">
        SELECT COUNT(*)
        FROM article_tag
        WHERE tag_id = #{tagId}
    </select>

</mapper>
