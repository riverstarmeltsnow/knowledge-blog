<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>cuit</groupId>
    <artifactId>Mygit</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>Mygit</name>
    <description>Mygit</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>21</java.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- MyBatis：Java 代码和数据库之间的桥梁。
             4.1.0 是专为 Spring Boot 4.1 出的版本线，和上面的 parent 版本对应。 -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>4.1.0</version>
        </dependency>

        <!-- 参数校验：加了它，实体类上的 @NotBlank / @Size 这些注解才会真的生效。
             底层是 Hibernate Validator（Jakarta Bean Validation 的标准实现），
             版本由上面的 spring-boot-starter-parent 统一管理，所以不用写 <version>。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Thymeleaf：服务端模板引擎。
             和 static/ 里那些页面是两条完全不同的路子：
             static/ 下的页面是"死的"，浏览器拿到后自己去调接口、再用 JS 拼出内容；
             有了它，Controller 可以直接把数据塞进模板，在服务器上拼好整页 HTML 再发出去。
             加了它以后，放在 resources/templates/ 下的 .html 会被自动接管，
             访问路径由 Controller 决定，不再对应文件位置。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- commonmark-java：把 Markdown 渲染成 HTML。
             它是 CommonMark 规范的 Java 实现 —— 和 GitHub、Stack Overflow
             用的是同一套语法规范，所以写法上跟它们对得上。

             为什么在**服务端**渲染，而不是引一个 marked.js 到前端？见
             cuit.mygit.common.MarkdownRenderer 里的说明。 -->
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark</artifactId>
            <version>0.24.0</version>
        </dependency>

        <!-- CommonMark 核心规范里没有表格（表格是 GitHub 自己扩的 GFM 的一部分），
             所以要单独引这个扩展才能认 | 表头 | 这种写法 -->
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark-ext-gfm-tables</artifactId>
            <version>0.24.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
